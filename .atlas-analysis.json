  "keyFeatures": [
    "Payment records access (one-time and recurring donations)",
    "Recurring subscription management with status and amount updates",
    "Donor contact creation and retrieval",
    "Fundraising and event form creation with rich customization",
    "Webhook event notifications with HMAC-SHA256 signature verification",
    "API usage analytics and webhook delivery logs",
    "Cursor-based pagination on all list endpoints",
    "Per-key rate limiting at 1,000 requests per hour",
    "Merchant-level data isolation and permission-based access control"
  ],
  "publicApiSurface": [
    "GET /v1/payments",
    "GET /v1/payments/{id}",
    "GET /v1/subscriptions",
    "GET /v1/subscriptions/{id}",
    "PUT /v1/subscriptions/{id}",
    "GET /v1/contacts",
